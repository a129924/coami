diff --git a/firmware/host/modules/input/wasm/touch-panel-bridge.js b/firmware/host/modules/input/wasm/touch-panel-bridge.js
new file mode 100644
--- /dev/null
+++ b/firmware/host/modules/input/wasm/touch-panel-bridge.js
@@ -0,0 +1,15 @@
+const call = native('xs_e016_touch_call')
+class WasmTouchPanel {
+  beginSample() { call(0, 0) }
+  sample() { return [call(1, 0), call(1, 1), call(1, 2)] }
+  ticks() { return call(2, 0) }
+  completeSample() { call(3, 0) }
+}
+export function currentTouchMetadata() {
+  return { session: call(4, 0), operation: call(4, 1), sample: call(4, 2) }
+}
+export function installWasmTouchPanel() {
+  globalThis.device ??= {}
+  globalThis.device.sensor ??= {}
+  globalThis.device.sensor.TouchPanel = WasmTouchPanel
+}
diff --git a/firmware/host/modules/input/wasm/touch-panel-bridge.c b/firmware/host/modules/input/wasm/touch-panel-bridge.c
new file mode 100644
--- /dev/null
+++ b/firmware/host/modules/input/wasm/touch-panel-bridge.c
@@ -0,0 +1,22 @@
+#include "xs.h"
+#include "xsmc.h"
+#include <emscripten.h>
+
+void xs_e016_touch_call(xsMachine* the)
+{
+  int method = xsmcToInteger(xsArg(0));
+  int slot = xsmcToInteger(xsArg(1));
+  int value = EM_ASM_INT({
+    const panel = stackchanRuntime.host && stackchanRuntime.host.TopTouchPanel;
+    if (!panel) return 0;
+    switch ($0) {
+      case 0: panel.beginSample(); return 0;
+      case 1: return panel.read($1) | 0;
+      case 2: return panel.ticks() | 0;
+      case 3: panel.completeSample(); return 0;
+      case 4: return panel.meta($1) | 0;
+    }
+    return 0;
+  }, method, slot);
+  xsmcSetInteger(xsResult, value);
+}
