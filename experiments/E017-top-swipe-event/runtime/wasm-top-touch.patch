diff --git a/firmware/host/modules/input/wasm/touch-panel-bridge.c b/firmware/host/modules/input/wasm/touch-panel-bridge.c
new file mode 100644
index 0000000..e58f47b
--- /dev/null
+++ b/firmware/host/modules/input/wasm/touch-panel-bridge.c
@@ -0,0 +1,35 @@
+#include "xs.h"
+#include "xsmc.h"
+#include <emscripten.h>
+
+/* One native call latches the browser tuple. No latest-pointer lookup. */
+void xs_stackchan_e017_take(xsMachine* the)
+{
+    int available = EM_ASM_INT({
+        const panel = stackchanRuntime.host && stackchanRuntime.host.TopTouchPanel;
+        if (!panel || !panel.take) return 0;
+        const t = panel.take();
+        const m = t.meta;
+        stackchanRuntime.e017Sample = Array.of(t.sample[0], t.sample[1], t.sample[2],
+            m.session, m.operation, m.sampleId, m.ticks, +m.terminal, +m.queued);
+        return 1;
+    });
+    if (!available) xsUnknownError("E017 raw TouchPanel provider unavailable");
+    xsmcVars(1);
+    xsmcSetNewArray(xsResult, 9);
+    for (int i = 0; i < 9; i++) {
+        double value = EM_ASM_DOUBLE({ return stackchanRuntime.e017Sample[$0]; }, i);
+        xsmcSetNumber(xsVar(0), value);
+        xsmcSetIndex(xsResult, i, xsVar(0));
+    }
+}
+
+void xs_stackchan_e017_consumed(xsMachine* the)
+{
+    int session = xsmcToInteger(xsArg(0));
+    int sample = xsmcToInteger(xsArg(1));
+    EM_ASM({
+        const panel = stackchanRuntime.host && stackchanRuntime.host.TopTouchPanel;
+        if (panel && panel.consumed) panel.consumed($0, $1);
+    }, session, sample);
+}
diff --git a/firmware/host/modules/input/wasm/touch-panel-bridge.js b/firmware/host/modules/input/wasm/touch-panel-bridge.js
new file mode 100644
index 0000000..613bd3e
--- /dev/null
+++ b/firmware/host/modules/input/wasm/touch-panel-bridge.js
@@ -0,0 +1,21 @@
+const take = native('xs_stackchan_e017_take')
+const acknowledge = native('xs_stackchan_e017_consumed')
+
+class WasmTouchPanel {
+  sample() {
+    const t = take()
+    globalThis.__coami17 = { session: t[3], operation: t[4], sampleId: t[5],
+      ticks: t[6], terminal: Boolean(t[7]), queued: Boolean(t[8]) }
+    this.current = globalThis.__coami17
+    return [t[0], t[1], t[2]]
+  }
+  ticks() { return this.current.ticks }
+  consumed() {
+    if (this.current.queued) acknowledge(this.current.session, this.current.sampleId)
+  }
+}
+export function installWasmTouchPanel() {
+  globalThis.device ??= {}
+  globalThis.device.sensor ??= {}
+  globalThis.device.sensor.TouchPanel = WasmTouchPanel
+}
