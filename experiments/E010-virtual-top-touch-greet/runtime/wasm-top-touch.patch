diff --git a/firmware/host/modules/input/wasm/touch-panel-bridge.c b/firmware/host/modules/input/wasm/touch-panel-bridge.c
new file mode 100644
index 00000000..89f51433
--- /dev/null
+++ b/firmware/host/modules/input/wasm/touch-panel-bridge.c
@@ -0,0 +1,26 @@
+#include "xs.h"
+#include "xsmc.h"
+#include <emscripten.h>
+
+void xs_stackchan_wasm_touch_panel_read(xsMachine* the)
+{
+	int index = (xsmcArgc > 0) ? xsmcToInteger(xsArg(0)) : -1;
+	int value = EM_ASM_INT({
+		const panel = stackchanRuntime.host && stackchanRuntime.host.TopTouchPanel;
+		if (($0 < 0) || ($0 >= 3) || !panel || !panel.read)
+			return 0;
+		return panel.read($0) | 0;
+	}, index);
+	xsmcSetInteger(xsResult, value);
+}
+
+void xs_stackchan_wasm_touch_panel_ticks(xsMachine* the)
+{
+	int ticks = EM_ASM_INT({
+		const panel = stackchanRuntime.host && stackchanRuntime.host.TopTouchPanel;
+		if (!panel || !panel.ticks)
+			return 0;
+		return panel.ticks() | 0;
+	});
+	xsmcSetInteger(xsResult, ticks);
+}
diff --git a/firmware/host/modules/input/wasm/touch-panel-bridge.js b/firmware/host/modules/input/wasm/touch-panel-bridge.js
new file mode 100644
index 00000000..f6c8735c
--- /dev/null
+++ b/firmware/host/modules/input/wasm/touch-panel-bridge.js
@@ -0,0 +1,23 @@
+const readHostTouchPanel = native('xs_stackchan_wasm_touch_panel_read')
+const readHostTouchPanelTicks = native('xs_stackchan_wasm_touch_panel_ticks')
+
+class WasmTouchPanel {
+  constructor() {}
+
+  sample() {
+    return [readHostTouchPanel(0), readHostTouchPanel(1), readHostTouchPanel(2)]
+  }
+
+  ticks() {
+    return readHostTouchPanelTicks()
+  }
+}
+
+export function installWasmTouchPanel() {
+  // The host bridge queues raw three-zone samples. TouchPanel's existing
+  // recognizer owns event construction, so MODs receive physical-driver
+  // semantics without a browser-visible event API.
+  globalThis.device ??= {}
+  globalThis.device.sensor ??= {}
+  globalThis.device.sensor.TouchPanel = WasmTouchPanel
+}

