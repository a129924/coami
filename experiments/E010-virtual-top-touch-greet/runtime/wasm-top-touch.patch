+export function updateTopTouchBusy(topTouchBridge, rawTrace) {
+  for (const line of String(rawTrace).split('\n')) {
+    if (!line.startsWith('COAMI10|')) continue
+    try {
+      const event = JSON.parse(line.slice(8))
+      if (event.kind !== 'run' || event.action_id !== 'greet') continue
+      if (event.phase === 'started') topTouchBridge.setBusy(true)
+      if (event.phase === 'completed' || event.phase === 'failed') topTouchBridge.setBusy(false)
+    } catch { /* Non-JSON trace output is not E010 lifecycle state. */ }
+  }
+}
