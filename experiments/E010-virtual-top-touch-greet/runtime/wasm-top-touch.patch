+export function createHostTopTouchBridge() {
+  const samples = []
+  let current = { sample: [0, 0, 0], ticks: 0 }
+  let ticks = 0
+  let busy = false
+
+  const enqueue = (sample) => {
+    samples.push({ sample, ticks: ++ticks })
+  }
+
+  const positionSample = (position) => {
+    if (position === -100) return [1, 0, 0]
+    if (position === 0) return [0, 1, 0]
+    if (position === 100) return [0, 0, 1]
+    return undefined
+  }
+
+  return {
+    tap(position) {
+      const sample = positionSample(position)
+      if (!sample || busy || samples.length > 0) return false
+      enqueue(sample)
+      enqueue([0, 0, 0])
+      return true
+    },
+    swipe(direction) {
+      if (busy || samples.length > 0) return false
+      const first = direction === 'forward' ? [1, 0, 0] : [0, 0, 1]
+      const second = direction === 'forward' ? [0, 0, 1] : [1, 0, 0]
+      enqueue(first)
+      enqueue(second)
+      enqueue([0, 0, 0])
+      return true
+    },
+    setBusy(value) {
+      busy = Boolean(value)
+      if (busy) samples.length = 0
+    },
+    read(index) {
+      if (index === 0 && samples.length > 0) current = samples.shift()
+      return current.sample[index] ?? 0
+    },
+    ticks() {
+      return current.ticks
+    },
+  }
+}
