{
  "name": "coami-e006-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "mod": "node scripts/build-mod.mjs",
    "prepare:poc": "npm run assets && npm run mod",
    "dev": "vite --host 127.0.0.1",
    "test": "node --test ../mod/wav.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../mod/tsconfig.json",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": { "three": "0.185.1" },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/three": "0.185.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
