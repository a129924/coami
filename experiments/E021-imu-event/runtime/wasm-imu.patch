diff --git a/firmware/host/modules/input/wasm/imu-bridge.c b/firmware/host/modules/input/wasm/imu-bridge.c
new file mode 100644
index 00000000..b9bc1a5d
--- /dev/null
+++ b/firmware/host/modules/input/wasm/imu-bridge.c
@@ -0,0 +1,31 @@
+#include "xs.h"
+#include "xsmc.h"
+#include <emscripten.h>
+
+void xs_stackchan_e021_ticks(xsMachine* the) {
+    xsmcSetNumber(xsResult, emscripten_get_now());
+}
+
+void xs_stackchan_e021_available(xsMachine* the) {
+    xsmcSetBoolean(xsResult, EM_ASM_INT({ return !!(stackchanRuntime.host && stackchanRuntime.host.IMU); }));
+}
+void xs_stackchan_e021_take(xsMachine* the) {
+    double ticks = xsmcToNumber(xsArg(0));
+    int available = EM_ASM_INT({
+        const input = stackchanRuntime.host && stackchanRuntime.host.IMU;
+        if (!input) return 0;
+        try {
+            const t = input.take($0);
+            stackchanRuntime.e021Sample = Array.of(t.sample.x,t.sample.y,t.sample.z,t.run,t.caseId,t.sampleId);
+            return 1;
+        } catch (error) { return 0; }
+    }, ticks);
+    if (!available) xsUnknownError("E021 IMU raw sample unavailable or source ended");
+    xsmcVars(1);
+    xsmcSetNewArray(xsResult, 6);
+    for (int i=0; i<6; i++) {
+        double value = EM_ASM_DOUBLE({ return stackchanRuntime.e021Sample[$0]; }, i);
+        xsmcSetNumber(xsVar(0), value);
+        xsmcSetIndex(xsResult, i, xsVar(0));
+    }
+}
diff --git a/firmware/host/modules/input/wasm/imu-bridge.js b/firmware/host/modules/input/wasm/imu-bridge.js
new file mode 100644
index 00000000..f727c288
--- /dev/null
+++ b/firmware/host/modules/input/wasm/imu-bridge.js
@@ -0,0 +1,25 @@
+import Time from 'time'
+const available = native('xs_stackchan_e021_available')
+const take = native('xs_stackchan_e021_take')
+class WasmIMU {
+  configure(options) {
+    if (options.order !== 'zxy') throw new Error('E021 expects configured recognizer frame zxy')
+  }
+  sample() {
+    const t = take(Time.ticks)
+    const sample = {accelerometer:{x:t[0],y:t[1],z:t[2]}}
+    const meta = {run:t[3],caseId:t[4],sampleId:t[5],sampleTicks:Time.ticks}
+    globalThis.__coami21 = meta
+    trace(`COAMI21|${JSON.stringify({kind:'raw',meta,sample})}\n`)
+    return sample
+  }
+}
+export function installWasmIMU() {
+  // Owner-approved E021 platform compatibility: pinned WASM xs_time_ticks is a stub.
+  // One real monotonic millisecond domain for original SDK IMU and this driver.
+  trace(`COAMI21|${JSON.stringify({kind:'clock',source:'emscripten_get_now',syntheticClock:false})}\n`)
+  if (!available()) return
+  globalThis.device ??= {}
+  globalThis.device.sensor ??= {}
+  globalThis.device.sensor.IMU = WasmIMU
+}
